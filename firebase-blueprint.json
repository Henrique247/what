{
  "entities": {
    "Bot": {
      "title": "Bot",
      "description": "Configuration for a WhatsApp bot",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "systemPrompt": { "type": "string" },
        "welcomeMsg": { "type": "string" },
        "exitMsg": { "type": "string" },
        "knowledgeBase": { "type": "string" },
        "geminiKeys": { "type": "string" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "groupWelcomeEnabled": { "type": "boolean" },
        "groupWelcomeMsg": { "type": "string" },
        "groupExitEnabled": { "type": "boolean" },
        "groupExitMsg": { "type": "string" },
        "respondInGroups": { "type": "boolean" },
        "respondInPrivate": { "type": "boolean" },
        "privateWelcomeEnabled": { "type": "boolean" },
        "privateExitEnabled": { "type": "boolean" },
        "memoryEnabled": { "type": "boolean" },
        "analysisEnabled": { "type": "boolean" },
        "analysisInstructions": { "type": "string" },
        "ownerName": { "type": "string" },
        "ownerNumber": { "type": "string" },
        "ownerId": { "type": "string" },
        "ownerPhone": { "type": "string" },
        "ownerPermissions": { "type": "array" },
        "accessToken": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Administrative audit trail for a bot",
      "type": "object",
      "properties": {
        "botId": { "type": "string" },
        "userId": { "type": "string" },
        "phone": { "type": "string" },
        "role": { "type": "string", "enum": ["OWNER", "ADMIN", "USER"] },
        "action": { "type": "string" },
        "command": { "type": "string" },
        "result": { "type": "string", "enum": ["SUCCESS", "DENIED", "ERROR"] },
        "details": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["botId", "role", "action", "result", "timestamp"]
    },
    "History": {
      "title": "History",
      "description": "Chat history for a bot and user",
      "type": "object",
      "properties": {
        "botId": { "type": "string" },
        "jid": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "model"] },
        "text": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["botId", "jid", "role", "text", "timestamp"]
    },
    "GroupConfig": {
      "title": "GroupConfig",
      "description": "Configuration and moderation settings for a WhatsApp group",
      "type": "object",
      "properties": {
        "botId": { "type": "string" },
        "groupId": { "type": "string" },
        "groupName": { "type": "string" },
        "antiLinkEnabled": { "type": "boolean" },
        "antiLinkAction": { "type": "string", "enum": ["delete", "warn", "remove", "delete_and_warn"] },
        "allowedLinks": { "type": "array", "items": { "type": "string" } },
        "antiBadWordsEnabled": { "type": "boolean" },
        "badWords": { "type": "array", "items": { "type": "string" } },
        "badWordsAction": { "type": "string", "enum": ["delete", "warn", "remove", "delete_and_warn"] },
        "antiSpamEnabled": { "type": "boolean" },
        "antiSpamMaxMessages": { "type": "number" },
        "antiSpamTimeWindowSeconds": { "type": "number" },
        "antiSpamAction": { "type": "string", "enum": ["warn", "remove", "delete"] },
        "adminImmunity": { "type": "boolean" },
        "maxWarnings": { "type": "number" },
        "autoKickOnMaxWarnings": { "type": "boolean" },
        "respondOnlyOnMentionOrReply": { "type": "boolean" },
        "responseCooldownSeconds": { "type": "number" },
        "dailyMotivationEnabled": { "type": "boolean" },
        "dailyMotivationTime": { "type": "string" },
        "dailyMotivationTimezone": { "type": "string" },
        "dailyMotivationTopic": { "type": "string" },
        "welcomeEnabled": { "type": "boolean" },
        "welcomeMessage": { "type": "string" },
        "exitEnabled": { "type": "boolean" },
        "exitMessage": { "type": "string" },
        "rulesText": { "type": "string" },
        "language": { "type": "string", "enum": ["pt", "en"] }
      },
      "required": ["botId", "groupId", "groupName"]
    },
    "GroupWarning": {
      "title": "GroupWarning",
      "description": "Warning record for a member in a group",
      "type": "object",
      "properties": {
        "botId": { "type": "string" },
        "groupId": { "type": "string" },
        "participantJid": { "type": "string" },
        "participantPhone": { "type": "string" },
        "count": { "type": "number" },
        "reasons": { "type": "array", "items": { "type": "string" } },
        "lastWarningAt": { "type": "string", "format": "date-time" }
      },
      "required": ["botId", "groupId", "participantJid", "count"]
    },
    "GroupLog": {
      "title": "GroupLog",
      "description": "Moderation and automation audit log for a group",
      "type": "object",
      "properties": {
        "botId": { "type": "string" },
        "groupId": { "type": "string" },
        "action": { "type": "string" },
        "actor": { "type": "string" },
        "targetUser": { "type": "string" },
        "reason": { "type": "string" },
        "details": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["botId", "groupId", "action", "timestamp"]
    },
    "BaileysAuth": {
      "title": "BaileysAuth",
      "description": "WhatsApp Baileys cryptographic session credentials and encryption keys for persistent auto-reconnection across redeploys",
      "type": "object",
      "properties": {
        "fileName": { "type": "string" },
        "rawContent": { "type": "string" },
        "category": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["fileName", "rawContent"]
    }
  },
  "firestore": {
    "/bots/{botId}": {
      "schema": "Bot",
      "description": "Collection of bots"
    },
    "/bots/{botId}/baileys_auth/{keyId}": {
      "schema": "BaileysAuth",
      "description": "Cryptographic authentication keys and session state for WhatsApp Baileys socket persistence"
    },
    "/bots/{botId}/history/{historyId}": {
      "schema": "History",
      "description": "Chat history for a specific bot"
    },
    "/bots/{botId}/audit_logs/{logId}": {
      "schema": "AuditLog",
      "description": "Audit logs for administrative operations on a bot"
    },
    "/bots/{botId}/groups/{groupId}": {
      "schema": "GroupConfig",
      "description": "Configuration for a WhatsApp group controlled by a bot"
    },
    "/bots/{botId}/groups/{groupId}/warnings/{warningId}": {
      "schema": "GroupWarning",
      "description": "Member warning records in a group"
    },
    "/bots/{botId}/groups/{groupId}/logs/{logId}": {
      "schema": "GroupLog",
      "description": "Moderation and automation activity log in a group"
    }
  }
}
