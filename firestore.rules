rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: bots
    // Document ID: botId
    // Fields:
    //   - id: string (required)
    //   - name: string (required)
    //   - systemPrompt: string
    //   - welcomeMsg: string
    //   - exitMsg: string
    //   - knowledgeBase: string
    //   - geminiKeys: string
    //   - active: bool
    //   - createdAt: timestamp
    //   - groupWelcomeEnabled: bool
    //   - groupWelcomeMsg: string
    //   - groupExitEnabled: bool
    //   - groupExitMsg: string
    //   - respondInGroups: bool
    //   - respondInPrivate: bool
    //   - privateWelcomeEnabled: bool
    //   - privateExitEnabled: bool
    //   - memoryEnabled: bool
    //   - analysisEnabled: bool
    //   - analysisInstructions: string
    //   - ownerName: string
    //   - ownerNumber: string
    //   - ownerId: string
    //   - ownerPhone: string
    //   - ownerPermissions: list
    //   - accessToken: string
    //
    // Subcollection: bots/{botId}/history
    // Document ID: historyId
    // Fields:
    //   - botId: string
    //   - jid: string
    //   - role: string (user/model)
    //   - text: string
    //   - timestamp: timestamp
    //
    // Subcollection: bots/{botId}/audit_logs
    // Document ID: logId
    // Fields:
    //   - botId: string
    //   - role: string
    //   - action: string
    //   - result: string
    //   - timestamp: timestamp
    //
    // ===============================================================

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (request.auth.token.email == "mendeshenrique158@gmail.com" && request.auth.token.email_verified == true);
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Validation Functions
    function isValidBot(data) {
      return data.keys().hasAll(['id', 'name']) &&
             data.id is string && data.name is string && data.name.size() < 100;
    }

    function isValidHistory(data) {
      return data.keys().hasAll(['botId', 'jid', 'role', 'text', 'timestamp']) &&
             data.botId is string && data.jid is string &&
             data.role in ['user', 'model'] && data.text is string &&
             data.timestamp is timestamp;
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['botId', 'role', 'action', 'result', 'timestamp']) &&
             data.botId is string && data.role is string &&
             data.action is string && data.result is string &&
             data.timestamp is timestamp;
    }

    // Bots collection & subcollections
    match /bots/{botId} {
      allow get, create, update, delete: if isValidId(botId);
      allow list: if true;

      match /history/{historyId} {
        allow get, create, update, delete: if isValidId(historyId);
        allow list: if true;
      }

      match /audit_logs/{logId} {
        allow get, create, update, delete: if isValidId(logId);
        allow list: if true;
      }

      match /groups/{groupId} {
        allow get, create, update, delete: if isValidId(groupId);
        allow list: if true;

        match /warnings/{warningId} {
          allow get, create, update, delete: if isValidId(warningId);
          allow list: if true;
        }

        match /logs/{logId} {
          allow get, create, update, delete: if isValidId(logId);
          allow list: if true;
        }
      }
    }

    // Admin Settings collection
    match /adminSettings/{docId} {
      allow get, create, update, delete: if isValidId(docId);
      allow list: if true;
    }

    // Bot Access Requests collection
    match /botAccessRequests/{reqId} {
      allow get, create, update, delete: if isValidId(reqId);
      allow list: if true;
    }

    // Global Default-Deny: Prevent all other unauthorized public paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
